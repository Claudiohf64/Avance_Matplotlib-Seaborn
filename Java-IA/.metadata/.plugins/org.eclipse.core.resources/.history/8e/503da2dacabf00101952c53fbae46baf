package Ejercicios;

public class Ejercicio1 {
	// Recursividad con memorizacion
	static int sumarHAsta(int n) {
		int suma = 0;
		for (int i = 0; i <= n; i++) {
			suma = i + sumarHAsta(n - 1);
		}
		return suma;
	}

	static int linea(int n) {
		for (int i = 0; i <= n; i++) {
			System.out.print("*");
			for (int j = 0; j <= i; j++) {
				System.out.println("*");
				System.out.print("*");
			}
		}
		return n;
	}

	public static void main(String[] args) {
		System.out.println(sumarHAsta(5));
		linea(10);
	}

}
