			public void iris_predic() {
				Instances iris;
				try {
					iris = DataSource.read("wine.arff");
					int nAttributes = iris.numAttributes();
					
					iris.setClassIndex(nAttributes - 1);
					IBk model = new IBk();
					model.setKNN(3);
					model.buildClassifier(iris);
					Instance florNueva = new DenseInstance(iris.numAttributes());
					
					florNueva.setValue(0,Double.parseDouble(txt_alt_sepalo.getText()));
					florNueva.setValue(1,Double.parseDouble(txt_anch_sepalo.getText()));
					florNueva.setValue(2,Double.parseDouble(txt_alt_petalo.getText()));
					florNueva.setValue(3,Double.parseDouble(txt_anch_petalo.getText()));
					florNueva.setDataset(iris);
					
					double index = model.classifyInstance(florNueva);
					String clase = iris.classAttribute().value((int) index);
					predic_result.setText("Clase: "+ String.format("%.2f", clase));
				} catch (Exception e) {
					// TODO Auto-generated catch block
					e.printStackTrace();
				}
				
			}
		});
		
