	public void colegio() {
		String url = "jdbc:mysql://localhost/colegio";
		String user = "root";
		String password = "";
		try {
			Connection cn = DriverManager.getConnection(url, user, password);
			String sql = "select edad,asistencia,promedio,conducta,apoyo_familiar,abandono from estudiantes_riesgo";
			PreparedStatement ps = cn.prepareStatement(sql);
			ResultSet rs = ps.executeQuery();
			DefaultTableModel model = new DefaultTableModel(null,
					new String[] { "edad", "asistencia", "promedio", "conducta", "apoyo_familiar", "abandono" });

			ArrayList<Attribute> atributos = new ArrayList<Attribute>();
			atributos.add(new Attribute("edad"));
			atributos.add(new Attribute("asistencia"));
			atributos.add(new Attribute("promedio"));

			ArrayList<String> valoresConducta = new ArrayList<String>();
			valoresConducta.add("buena");
			valoresConducta.add("regular");
			valoresConducta.add("mala");
			atributos.add(new Attribute("conducta", valoresConducta));

			ArrayList<String> valoresApoyo_f = new ArrayList<String>();
			valoresApoyo_f.add("si");
			valoresApoyo_f.add("no");
			atributos.add(new Attribute("apoyo_familiar", valoresApoyo_f));

			ArrayList<String> valoresAbandono = new ArrayList<String>();
			valoresAbandono.add("si");
			valoresAbandono.add("no");
			atributos.add(new Attribute("abandono", valoresAbandono));

			
			
			Instances data = new Instances("dataset", atributos, 0);
			data.setClassIndex(data.numAttributes() - 1);

			while (rs.next()) {
				Instance instance = new DenseInstance(data.numAttributes());
				instance.setValue(atributos.get(0), rs.getInt("edad"));
				instance.setValue(atributos.get(1), rs.getInt("asistencia"));
				instance.setValue(atributos.get(2), rs.getDouble("promedio"));
				instance.setValue(atributos.get(3), rs.getString("conducta"));
				instance.setValue(atributos.get(4), rs.getString("apoyo_familiar"));
				instance.setValue(atributos.get(5), rs.getString("abandono"));
				instance.setDataset(data);
				data.add(instance);
			}

			for (Instance datos : data) {
				model.addRow(new Object[] { datos.value(0), datos.value(1), datos.value(2), datos.value(3),
						datos.value(4), datos.value(5) });
			}

			grilla.setModel(model);
		} catch (

		Exception e) {
			e.printStackTrace();
		}
	}

	public void prediccion() {
		Classifier model = new J48();
		try {
			model.buildClassifier(data);
			Instance muestra = new DenseInstance(data.numAttributes());
			muestra.setValue(atributos.get(0), Integer.parseInt(txt_edad.getText()));
			muestra.setValue(atributos.get(1), Integer.parseInt(txt_asistencia.getText()));
			muestra.setValue(atributos.get(2), Double.parseDouble(txt_promedio.getText()));
			muestra.setValue(atributos.get(3), );
			muestra.setValue(atributos.get(4), );
			muestra.setDataset(data);

			double indice = model.classifyInstance(muestra);
			String clase = data.classAttribute().value((int)indice);
			JL_result.setForeground(Color.BLACK);
			JL_result.setText("Prediccion de abandono:"+ clase);
		} catch (Exception e) {
			e.printStackTrace();
		}
