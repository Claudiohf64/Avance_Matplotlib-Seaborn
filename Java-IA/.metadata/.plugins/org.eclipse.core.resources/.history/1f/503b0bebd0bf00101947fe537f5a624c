package Tareas;

import java.util.HashMap;
import java.util.Map;

public class Tarea1 {
	// Recursividad con memorizacion
	static HashMap<Integer, String> memoria = new HashMap<Integer, String>();

	static String sumarHAsta(int n) {
		if (n == 0) {
			return "";
		}

		if (memoria.containsKey(n)) {
			return memoria.get(n);
		}
		String linea = "*";

		memoria.put(n, linea);
		return linea;
	}

	public static void main(String[] args) {
		for (Map.Entry<Integer, String> memo : memoria.entrySet()) {
			System.out.println(memo.getKey() + " " + memo.getValue());
		}
	}
}
