package Ejercicios;

public class Ejercicio1 {
	//Recursividad con memorizacion
	static int sumarHAsta(int n) {
		int suma =0;
		for (int i = 0;i<=n;i++) {
			suma = i + sumarHAsta(n-1);
		}
		System.out.println(suma);
		return n;
	}
	public static void main(String[] args) {
		System.out.println(sumarHAsta(5));
	}

}
